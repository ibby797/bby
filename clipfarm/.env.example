# ClipFarm settings — copy this file to `.env` and fill in what you need.
#   cp .env.example .env
#
# Everything here is OPTIONAL. ClipFarm runs with zero config locally.
# You only need values below when hosting it as a website or turning on
# TikTok posting / AI features.
#
# How each host reads this:
#   • docker compose  → reads .env automatically (same folder as docker-compose.yml)
#   • Render / Fly    → set these as environment variables / secrets in the dashboard
#   • local dev       → `export VAR=value` in your shell, or use a tool like direnv

# ─────────────────────────────────────────────────────────────────────────
# WEBSITE SECURITY  (set this the moment ClipFarm is reachable on the internet)
# ─────────────────────────────────────────────────────────────────────────
# Password for the whole site. Login username is always: clipfarm
# Leave blank for local-only use; REQUIRED for any public deployment.
CLIPFARM_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# YOUTUBE DOWNLOADS
# ─────────────────────────────────────────────────────────────────────────
# Cloud servers often get blocked by YouTube. Export your browser's YouTube
# cookies to a cookies.txt (any "cookies.txt" browser extension), put the
# file where the app can read it, and point here. Not needed on home/VPS IPs.
# CLIPFARM_COOKIES=/data/cookies.txt

# ─────────────────────────────────────────────────────────────────────────
# AI-ENHANCED RANKING  (optional — also run: pip install anthropic)
# ─────────────────────────────────────────────────────────────────────────
# With this set, Claude re-ranks the top viral candidates and writes
# punchier on-screen hook titles. Get a key at console.anthropic.com
# ANTHROPIC_API_KEY=
# CLIPFARM_ANTHROPIC_MODEL=claude-opus-4-8

# ─────────────────────────────────────────────────────────────────────────
# TIKTOK AUTO-POSTING  (optional — create an app at developers.tiktok.com)
# ─────────────────────────────────────────────────────────────────────────
# Add the "Content Posting API" product and request the video.upload +
# video.publish scopes. Without these, automation runs in "export mode":
# clips are marked ready-to-post on schedule and you upload them yourself.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
#
# The redirect URI must EXACTLY match what you register in the TikTok app.
#   local:  http://localhost:8000/api/tiktok/callback
#   hosted: https://your-domain.com/api/tiktok/callback
# TIKTOK_REDIRECT_URI=http://localhost:8000/api/tiktok/callback
#
# inbox  = clips land in your TikTok drafts, you tap Post (works for unaudited apps)
# direct = publish with no tap (public direct posting needs TikTok app audit;
#          unaudited apps can only direct-post as private/SELF_ONLY)
# TIKTOK_POST_MODE=inbox

# ─────────────────────────────────────────────────────────────────────────
# POSTING CADENCE  (how the automation drip-posts)
# ─────────────────────────────────────────────────────────────────────────
# Posts per day (hard-capped at 25 = TikTok's API limit)
# CLIPFARM_POSTS_PER_DAY=6
# Daily posting window, local 24h hours
# CLIPFARM_POST_WINDOW_START=9
# CLIPFARM_POST_WINDOW_END=23
# Random +/- minutes added to each slot so it looks organic
# CLIPFARM_POST_JITTER_MIN=25

# ─────────────────────────────────────────────────────────────────────────
# RENDERING / ANALYSIS  (tweak only if you know why)
# ─────────────────────────────────────────────────────────────────────────
# CLIPFARM_MAX_CLIPS=100            # clips per video
# CLIPFARM_MIN_CLIP=12             # shortest clip (seconds)
# CLIPFARM_MAX_CLIP=58             # longest clip (seconds)
# CLIPFARM_RENDER_CONCURRENCY=2    # parallel ffmpeg renders (raise on big servers)
# CLIPFARM_MAX_HEIGHT=1080         # source download quality cap
# CLIPFARM_FONT=DejaVu Sans        # caption font
# CLIPFARM_DATA=/data              # where jobs, clips, tokens are stored
